<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B3D0B"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- ===== JETONS ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#BDBDBD" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <androidx.cardview.widget.CardView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" app:cardBackgroundColor="#F2F2F2" app:cardCornerRadius="11dp" app:cardElevation="0dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#E5202A" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <androidx.cardview.widget.CardView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" app:cardBackgroundColor="#F2F2F2" app:cardCornerRadius="11dp" app:cardElevation="0dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#3F6FD1" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <androidx.cardview.widget.CardView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" app:cardBackgroundColor="#F2F2F2" app:cardCornerRadius="11dp" app:cardElevation="0dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#1FA32A" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <androidx.cardview.widget.CardView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" app:cardBackgroundColor="#F2F2F2" app:cardCornerRadius="11dp" app:cardElevation="0dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#111111" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <androidx.cardview.widget.CardView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" app:cardBackgroundColor="#F2F2F2" app:cardCornerRadius="11dp" app:cardElevation="0dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#5B2A86" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <androidx.cardview.widget.CardView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" app:cardBackgroundColor="#F2F2F2" app:cardCornerRadius="11dp" app:cardElevation="0dp" />
