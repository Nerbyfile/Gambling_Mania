            <!-- 0 : trios (0-1-2, 0-2-3) -->
            <View android:id="@+id/trio_0_1_2" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="29dp" android:layout_marginTop="23dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/trio_0_2_3" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="64dp" android:layout_marginTop="23dp" android:clickable="true" android:focusable="true" />
