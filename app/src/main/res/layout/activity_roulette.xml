            <View android:id="@+id/split_2_3" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="63dp" android:layout_marginTop="34.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_4_5" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="28dp" android:layout_marginTop="63.5dp" android:clickable="true" android:focusable="true" />
