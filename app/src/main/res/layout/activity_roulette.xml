            <View android:id="@+id/split_17_18" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="63dp" android:layout_marginTop="179.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_19_20" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="28dp" android:layout_marginTop="208.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_20_21" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="63dp" android:layout_marginTop="208.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_22_23" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="28dp" android:layout_marginTop="237.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_23_24" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="63dp" android:layout_marginTop="237.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_25_26" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="28dp" android:layout_marginTop="266.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_26_27" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="63dp" android:layout_marginTop="266.5dp" android:clickable="true" android:focusable="true" />
