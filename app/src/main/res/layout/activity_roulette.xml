                    <TextView android:id="@+id/n33" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="33" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
