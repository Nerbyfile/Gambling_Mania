                    <TextView android:id="@+id/n13" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="13" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n14" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="14" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n15" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="15" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n16" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="16" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n17" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="17" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n18" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="18" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n19" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="19" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n20" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="20" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n21" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="21" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n22" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="22" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n23" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="23" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n24" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="24" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n25" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="25" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n26" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="26" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
