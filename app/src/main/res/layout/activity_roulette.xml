            <View android:id="@+id/split_7_8" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="28dp" android:layout_marginTop="92.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_8_9" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="63dp" android:layout_marginTop="92.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_10_11" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="28dp" android:layout_marginTop="121.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_11_12" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="63dp" android:layout_marginTop="121.5dp" android:clickable="true" android:focusable="true" />
            <View android:id="@+id/split_13_14" android:layout_width="14dp" android:layout_height="18dp" android:layout_marginStart="28dp" android:layout_marginTop="150.5dp" android:clickable="true" android:focusable="true" />
