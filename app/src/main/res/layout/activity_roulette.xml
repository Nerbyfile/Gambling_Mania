                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="12">

                    <TextView android:id="@+id/n1" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="1" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n2" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0A0A0A" android:gravity="center" android:text="2" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/n3" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#FF2D2D" android:gravity="center" android:text="3" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
