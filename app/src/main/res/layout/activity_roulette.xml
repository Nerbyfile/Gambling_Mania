    </LinearLayout>

    <!-- ===== TABLE ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#E6E6E6"
        android:orientation="horizontal"
        android:padding="1dp">

        <!-- Chances simples (colonne exterieure) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View android:layout_width="30dp" android:layout_height="29dp" />
            <TextView android:id="@+id/bet_low" android:layout_width="30dp" android:layout_height="57dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="1-18" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/bet_even" android:layout_width="30dp" android:layout_height="57dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="PAIR" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/bet_red" android:layout_width="30dp" android:layout_height="57dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="◆" android:textColor="#FF2D2D" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/bet_black" android:layout_width="30dp" android:layout_height="57dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="◆" android:textColor="#000000" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/bet_odd" android:layout_width="30dp" android:layout_height="57dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="IMP." android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/bet_high" android:layout_width="30dp" android:layout_height="57dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="19-36" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Douzaines (collees aux numeros) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View android:layout_width="30dp" android:layout_height="29dp" />
            <TextView android:id="@+id/bet_dozen1" android:layout_width="30dp" android:layout_height="115dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="1-12" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/bet_dozen2" android:layout_width="30dp" android:layout_height="115dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="13-24" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/bet_dozen3" android:layout_width="30dp" android:layout_height="115dp" android:layout_margin="0.5dp" android:background="#0B3D0B" android:gravity="center" android:text="25-36" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Zero + numeros + colonnes + zones de paris a cheval / carres -->
