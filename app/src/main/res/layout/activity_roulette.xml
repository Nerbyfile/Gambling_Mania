                </GridLayout>

                <!-- Colonnes (2 pour 1) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/bet_col1" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0F3A12" android:gravity="center" android:text="2:1" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/bet_col2" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0F3A12" android:gravity="center" android:text="2:1" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/bet_col3" android:layout_width="34dp" android:layout_height="28dp" android:layout_margin="0.5dp" android:background="#0F3A12" android:gravity="center" android:text="2:1" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== ZONES CLIQUABLES INVISIBLES =====
                 Pour les voir : ajoute android:background="#55FFFF00" -->
            <!-- 0 : demi-chevaux (0-1, 0-2, 0-3) -->
