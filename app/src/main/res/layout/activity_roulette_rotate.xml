<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B3D0B">

    <!-- Table à l'horizontale, avec les paris -->
    <com.example.my_application_sandbox.MiniTableView
        android:id="@+id/mini_table"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintDimensionRatio="H,14:5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Roue + balle : carré, centré -->
    <FrameLayout
        android:id="@+id/wheel_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_spin"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/mini_table">

        <!-- La roue (rotation autour de son centre) -->
        <com.example.my_application_sandbox.RouletteWheelView
            android:id="@+id/wheel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Orbite de la balle : même taille que la roue.
             On tourne CE conteneur pour faire orbiter la balle. -->
        <FrameLayout
            android:id="@+id/ball_orbit"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/ball"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardCornerRadius="7dp"
                app:cardElevation="4dp" />
        </FrameLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btn_spin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="LANCER"
        app:layout_constraintTop_toBottomOf="@+id/wheel_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/btn_spin_bg"
        android:elevation="6dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        android:minWidth="240dp"
        android:minHeight="60dp"
        android:paddingHorizontal="32dp"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        app:backgroundTint="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>