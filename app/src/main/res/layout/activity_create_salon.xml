<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B3D0B"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edit_salon_name"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:hint="Nom de la salle"
        android:maxLength="20"
        android:singleLine="true"
        android:textColor="#FFF3C4"
        android:textColorHint="#9FBF9F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_invite_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="Inviter des amis"
        android:textColor="#C9A227"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/friends_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_invite_friends"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/txt_friends_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="Tu n'as pas encore d'amis à inviter"
            android:textColor="#9FBF9F"
            android:visibility="gone" />
    </FrameLayout>

    <CheckBox
        android:id="@+id/check_private"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="#C9A227"
        android:text="Salle privée (accès par code uniquement)"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/card_bg"
            android:contentDescription="Retour"
            android:src="@drawable/ic_fleche_back" />

        <Button
            android:id="@+id/btn_create"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="#C9A227"
            android:elevation="6dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="CRÉER"
            android:textColor="#0A0A0A"
            android:textSize="18sp"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>